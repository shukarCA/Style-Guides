{
  "window.autoDetectColorScheme": true,
  "workbench.startupEditor": "none",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "security.workspace.trust.untrustedFiles": "open",
  "chat.agent.enabled": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "editor.autoIndentOnPaste": true,
  "editor.autoIndentOnPasteWithinString": false,
  "editor.inlineSuggest.edits.renderSideBySide": "never",
  "json.schemaDownload.trustedDomains": {
    "https://raw.githubusercontent.com/LuaLS/vscode-lua": true
  },
  // Visual anchors for your 80-character soft cap and 120-character hard cap
  "editor.rulers": [
    80,
    120
  ],
  // Auto Docstring Configuration
  "autoDocstring.docstringFormat": "google",
  // CSS Extension Specifics
  "csscomb.formatOnSave": true,
  "stylelint.validate": [
    "css"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "explicit"
  },
  // File Associations
  "files.associations": {
    "*.qplug": "lua",
    "*.j2": "jinja",
    "*.yaml": "yaml",
    "*.yml": "yaml",
    "docker-compose*.yaml": "dockercompose",
    "docker-compose*.yml": "dockercompose",
    "compose*.yaml": "dockercompose",
    "compose*.yml": "dockercompose",
    "**/playbooks/**/*.yaml": "ansible",
    "**/playbooks/**/*.yml": "ansible",
    "**/roles/**/*.yaml": "ansible",
    "**/roles/**/*.yml": "ansible",
    "**/tasks/**/*.yaml": "ansible",
    "**/tasks/**/*.yml": "ansible",
    "pb-*.yaml": "ansible",
    "pb-*.yml": "ansible",
    "configuration.yaml": "home-assistant",
    "automations.yaml": "home-assistant",
    "scripts.yaml": "home-assistant",
    "scenes.yaml": "home-assistant",
    "sensors.yaml": "home-assistant"
  },
  // Global CSS Configuration
  "css.format.spaceAroundSelectorSeparator": true,
  "css.format.newlineBetweenRules": true,
  "css.format.newlineBetweenSelectors": true,
  // Global Lua Configuration
  "Lua.runtime.version": "Lua 5.3",
  "Lua.diagnostics.enable": true,
  // Global Python Configuration
  "python.analysis.indexing": true,
  "python.analysis.typeCheckingMode": "basic",
  // Global YAML Configuration
  "yaml.format.enable": true,
  "yaml.validate": true,
  "yaml.hover": true,
  "yaml.completion": true,
  "yaml.schemaStore.enable": true,
  // Language Specific Overrides
  "[ansible]": {
    "editor.defaultFormatter": "redhat.ansible"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[home-assistant]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[jinja]": {
    "editor.defaultFormatter": "samuelcolvin.jinjahtml"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit"
    }
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.fixAll.ruff": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[shellscript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.formatOnSave": true
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  // Markdown Extension Specifics
  "markdown.extension.preview.autoShowPreviewToSide": true,
  "markdown.extension.print.absoluteImgPath": false,
  "markdown.validate.enabled": true,
  // Red Hat Ansible Extension Settings (Enforces Style Guide Rules via Lint)
  "ansible.validation.lint.enabled": true,
  "ansible.validation.lint.path": "ansible-lint",
  "ansible.ansible.useFullyQualifiedCollectionNames": true,
  // ShellCheck Enforcement
  "shellcheck.enable": true,
  "shellcheck.run": "onType",
  // --- shfmt Flags Matching Google Style Guide ---
  // -i 2: Force 2 spaces for indentation
  // -sr: Add spaces after redirect operators (e.g., > /dev/null)
  // -kp: Keep padding spaces inside parentheses
  "shellformat.flag": "-i 2 -sr -kp",
  // Theme Configurations
  "workbench.preferredDarkColorTheme": "Visual Studio Dark",
  "workbench.colorTheme": "Visual Studio Dark",
  "workbench.preferredLightColorTheme": "Visual Studio Light",
  "redhat.telemetry.enabled": true
}
